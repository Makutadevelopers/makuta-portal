# Reference for the production environment file at
#   /opt/makuta-portal/infra/prod/.env  on the EC2 host.
#
# This repo deploys directly to AWS — there is no local-dev stack.
# All values below MUST be filled in on the EC2 box before running
#   ./infra/prod/deploy.sh
# Anything obviously placeholder will be rejected at startup.

# ── Server ────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Database (Neon, us-east-1, SSL required) ─────────────
# Use the full Neon pooler connection string with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/makuta_portal?sslmode=require

# ── JWT ───────────────────────────────────────────────────
# Generate:  openssl rand -hex 48
JWT_SECRET=__replace_with_at_least_48_chars__

JWT_EXPIRES_IN=8h

# ── AWS S3 (invoice attachments) ─────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=makuta-invoice-attachments

# ── Email (optional, AWS SES / Gmail / SendGrid) ─────────
# Leave empty to disable email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@makutadevelopers.com

# ── CORS ─────────────────────────────────────────────────
# Production frontend origin(s), comma-separated.
ALLOWED_ORIGINS=https://invoice.makutadevelopers.com

# ── Cron shared secret ───────────────────────────────────
# Required in production so /api/cron/* endpoints authenticate.
# Generate:  openssl rand -hex 32
CRON_SECRET=

# ── Backups (optional override) ──────────────────────────
# S3_BACKUP_BUCKET=makuta-backups
# BACKUP_DIR=./backups
# RETENTION_DAYS=30

# ── Client (Vite) ────────────────────────────────────────
VITE_API_BASE_URL=/api
