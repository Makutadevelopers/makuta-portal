# Dependencies
node_modules/
**/node_modules/

# Environment — NEVER commit .env
.env
.env.local
.env.*.local

# Build output
client/dist/
server/dist/

# TypeScript cache
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Logs
*.log
npm-debug.log*

# AWS
.aws/

# Local DB backups — can contain real data
backups/

# Claude Code runtime artifacts (lock files, transient state)
.claude/scheduled_tasks.lock

# Private keys and certificates — never commit. The repo has none today; this
# is here so an accidental `git add .` after dropping a .pem in the tree
# cannot publish it.
*.pem
*.key
*.p12
*.pfx
