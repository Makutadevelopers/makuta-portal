# Makuta Portal — production .env template
#
# Copy to /opt/makuta-portal/.env on the EC2 host and fill in the marked
# values. server/src/config/env.ts blocks startup if any prod-unsafe
# placeholder remains (JWT, DB, AWS, ALLOWED_ORIGINS, CRON_SECRET).

# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Database (AWS RDS Postgres, us-east-1, SSL required) ─────────────────
DB_HOST=REPLACE_WITH_RDS_ENDPOINT.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=makuta_portal
DB_USER=makuta_admin
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_SSL=true

# ── JWT ───────────────────────────────────────────────────────────────────
# Generate:  openssl rand -hex 48
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_48
JWT_EXPIRES_IN=8h

# ── AWS S3 (invoice attachments) ─────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_IAM_USER_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_IAM_USER_SECRET
S3_BUCKET_NAME=makuta-portal-attachments-prod

# ── CORS ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://invoice.makutadevelopers.com

# ── Cron shared secret ───────────────────────────────────────────────────
# Generate:  openssl rand -hex 32
CRON_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# ── Email (optional — leave blank to disable email notifications) ────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@makutadevelopers.com
