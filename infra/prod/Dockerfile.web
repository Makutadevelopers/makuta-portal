# Makuta Portal Web — production image
# Stage 1: build Vite SPA. Stage 2: serve with nginx:alpine.
# Build context is the repo root so we can COPY client/.

# ── Stage 1: build ──────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Vite reads VITE_* at build time and bakes them into the bundle.
# Default to a same-origin /api path; the public nginx proxies /api/* to portal-api.
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

COPY client/package.json client/package-lock.json* ./
# --legacy-peer-deps: vite-plugin-pwa@1.2.0 declares peer vite ≤7 but the
# project pins vite@8. Local `npm install` is lenient, `npm ci` is strict.
RUN npm ci --no-audit --no-fund --legacy-peer-deps

COPY client/ ./

# Cap node heap to keep builds within the EC2's ~954 MB RAM (with swap as buffer).
ENV NODE_OPTIONS=--max-old-space-size=512
RUN npm run build

# ── Stage 2: serve ──────────────────────────────────────────────────────────
FROM nginx:1.25-alpine

# Drop default vhost; install ours (SPA fallback + asset caching).
RUN rm /etc/nginx/conf.d/default.conf
COPY infra/prod/web-nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
